# How to deploy this file:
# ln -f -s "$PWD/.gitconfig" "$HOME"

[advice]
    skippedCherryPicks = false
[alias]
    cam = commit --all --amend --no-verify -m
    can = !git add --all && git commit --amend --no-edit
    cge = config edit --global # opens ~/.gitconfig
    cgl = config list --global # lists all the variables in ~/.gitconfig
    cp = cherry-pick
    discard = restore --staged --worktree .
    empty = commit --allow-empty --allow-empty-message --no-edit
    pf = push --force-with-lease --force-if-includes
    pop = stash pop
    rd = !git fetch --prune --prune-tags origin +develop:develop && git rebase develop
    rh = reset --hard HEAD~
    ri = rebase --interactive
    rir = rebase --interactive --root
    st = stash push --include-untracked # `push` cannot be used as an alias
    sub = submodule update --force --init --recursive
    uncommit = reset --soft HEAD~
[column]
    ui = auto
[core]
    autocrlf = input # https://git-scm.com/book/en/v2/Customizing-Git-Git-Configuration
    editor = antigravity-ide --wait
    fsmonitor = true
    quotepath = false
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[diff]
    algorithm = histogram
    colorMoved = dimmed-zebra
    mnemonicPrefix = true
    renames = copies
    tool = mytool
[difftool]
    prompt = false
[difftool "mytool"]
    cmd = antigravity-ide --wait --diff "$LOCAL" "$REMOTE"
[fetch]
    all = true
    prune = true
    pruneTags = true
    recurseSubmodules = true
    writeCommitGraph = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    process = git-lfs filter-process
    required = true
    smudge = git-lfs smudge -- %f
[help]
    autocorrect = prompt
[includeIf "gitdir:/Users/work/"] # Don't use a tilde (~) because GitHub Desktop doesn't recognize it.
    path = ~/.gitconfig.work
[init]
    defaultBranch = main
[log]
    follow = true
[merge]
    autoStash = true
    conflictStyle = zdiff3
    tool = mytool
[mergetool]
    keepBackup = false
    prompt = false
[mergetool "mytool"]
    cmd = antigravity-ide --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"
[pager]
    branch = false # makes "git branch" list branches without using a pager.
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[rerere]
    autoUpdate = true
    enabled = true
[user]
    email = 1838962+tatsuyafujisaki@users.noreply.github.com
    name = Tatsuya Fujisaki

# Finding default values in Git Config can be challenging. Refer to the website below for more information.
# https://git-scm.com/docs/git-config
