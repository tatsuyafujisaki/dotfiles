# How to deploy this file:
# ln -f -s "$HOME/Documents/GitHub/dotfiles/git/.gitconfig" "$HOME"

[advice]
    skippedCherryPicks = false
[alias]
    a = !pbpaste | git apply --ignore-space-change
    b = branch
    bd = !git branch | grep --invert-match "^\\*" | xargs --no-run-if-empty git branch -D
    cam = commit --all --amend --no-verify -m
    can = !git add --all && git commit --amend --no-edit
    cge = config edit --global # opens ~/.gitconfig
    cgl = config list --global # lists all the variables in ~/.gitconfig
    cm = commit -m
    cp = cherry-pick
    csol = config --show-origin --list
    d = !git --no-pager diff | pbcopy
    empty = commit --allow-empty --allow-empty-message --no-edit
    lp = log --patch -- # takes <file> and shows the change history of the file.
    ma = merge --abort
    md = merge develop --no-edit
    mt = mergetool
    pf = push --force-with-lease --force-if-includes
    pop = stash pop
    r = rebase
    ra = rebase --abort
    rc = rebase --continue
    rd = !git fetch --prune --prune-tags origin +develop:develop && git rebase develop
    ri = rebase --interactive
    rir = rebase --interactive --root
    rs = reset HEAD~
    rsh = reset --hard HEAD~
    st = stash push --include-untracked # `push` cannot be used as an alias
    sw = switch
[column]
    ui = auto
[core]
    autocrlf = input # https://git-scm.com/book/en/v2/Customizing-Git-Git-Configuration
    editor = antigravity-ide --wait
    excludesFile = ~/.gitignore
    fsmonitor = true
    precomposeunicode = true
    quotepath = false
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[diff]
    algorithm = histogram
    colorMoved = dimmed-zebra
    tool = mytool
[difftool]
    prompt = false
[difftool "mytool"]
    cmd = antigravity-ide --wait --diff "$LOCAL" "$REMOTE"
[fetch]
    prune = true
    pruneTags = true
    recurseSubmodules = true
[init]
    defaultBranch = main
[merge]
    autoStash = true
    conflictStyle = zdiff3
    tool = mytool
[mergetool]
    prompt = false
    keepBackup = false
[mergetool "mytool"]
    cmd = antigravity-ide --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"
[help]
    autocorrect = prompt
[pager]
    branch = false # makes "git branch" list branches without using a pager.
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    useForceIfIncludes = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[rerere]
    enabled = true
    autoUpdate = true
[user]
    name = Tatsuya Fujisaki
    email = 1838962+tatsuyafujisaki@users.noreply.github.com
[includeIf "gitdir:/Users/work/"]
    path = ~/.gitconfig.work
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# Finding default values in Git Config can be challenging. Refer to the website below for more information.
# https://git-scm.com/docs/git-config
